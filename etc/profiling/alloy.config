// eBPF profiling of every rayls-network process on the Docker host (the container runs with
// `pid: host`), labelled with its compose service so flame graphs can be filtered per validator.
//
// pyroscope.ebpf embeds Grafana's fork of the OpenTelemetry eBPF profiler. It symbolizes native
// frames on the host from the binary's symbol table, so the Rust node needs no instrumentation
// and no debuginfo upload, only an unstripped binary.

// compose metadata (service name) for each container, joined to its processes below
discovery.docker "compose" {
	host = "unix:///var/run/docker.sock"
}

discovery.process "all" {
	refresh_interval = "10s"
	join             = discovery.docker.compose.targets
}

discovery.relabel "rayls" {
	targets = discovery.process.all.targets

	rule {
		source_labels = ["__meta_process_exe"]
		regex         = "/usr/local/bin/rayls"
		action        = "keep"
	}

	rule {
		target_label = "service_name"
		replacement  = "rayls-network"
	}
	// validator1..4 (or setupN / comittee for the short-lived bootstrap containers)
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "validator"
	}
}

pyroscope.ebpf "rayls" {
	targets    = discovery.relabel.rayls.output
	forward_to = [pyroscope.write.local.receiver]

	// on-CPU stack samples per second per CPU (default 19)
	sample_rate = 97
	// readable Rust names (`tokio::runtime::task::raw::RawTask::poll`) instead of mangled ones
	demangle = "full"
	// also record 5% of context switches as an `offcpu` profile type: where threads block
	// (locks, blocking I/O, parked tokio workers) and for how long
	off_cpu_threshold = 0.05
}

pyroscope.write "local" {
	endpoint {
		url = "http://pyroscope:4040"
	}
}
