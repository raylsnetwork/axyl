# --- Always required ---------------------------------------------------
ADDRESS="0x"
GENESISDIR="/genesis"
# BLS keystore passphrase. Leave empty to default to "local" (throwaway
# nodes only). Set a strong value for any node you intend to keep -- the
# same passphrase must be used when starting the node.
RL_BLS_PASSPHRASE=""

# --- Required only for the full staking flow (NOT for --config-only) ---
ADMIN_PRIVATE_KEY="0x"
PRIVATE_KEY="0x"
RPC_URL=""
STAKE_AMOUNT="1000000000000000000000000"

# --- Optional: externally-reachable p2p multiaddrs --------------------
# Set these to your public IP so other peers can dial the validator once it
# is running on its own host. Leave at the 0.0.0.0 defaults for an
# outbound-only / NAT'd node.
RL_EXTERNAL_PRIMARY_ADDR="/ip4/0.0.0.0/udp/49001/quic-v1"
RL_EXTERNAL_WORKER_ADDRS="/ip4/0.0.0.0/udp/49101/quic-v1"
