# --- Always required ---------------------------------------------------
# Validator's operator address (receives rewards, will hold the stake).
ADDRESS="0x"
# Directory containing genesis.yaml and committee.yaml.
# parameters.yaml is read from ${GENESISDIR}/..
GENESISDIR="/genesis"
# BLS keystore passphrase. Required for --config-only. The same passphrase
# must be set (RL_BLS_PASSPHRASE) when starting the node. Use a strong value
# for any node you intend to keep.
RL_BLS_PASSPHRASE=""

# --- Optional: externally-reachable p2p multiaddrs --------------------
# Written into node-info.yaml. Set to the public IP/ports of the host that
# will run the validator so other peers can dial it.
#RL_EXTERNAL_PRIMARY_ADDR="/ip4/<PUBLIC_IP>/udp/49001/quic-v1"
#RL_EXTERNAL_WORKER_ADDRS="/ip4/<PUBLIC_IP>/udp/49101/quic-v1"

# --- Build ------------------------------------------------------------
BUILD_CONFIG="debug"
RAYLS_NETWORK="local"

# --- Required only for the full flow / activate / exit -----------------
# NOT needed for ./create-validator.sh --config-only
ADMIN_PRIVATE_KEY="0x"
PRIVATE_KEY="0x"
RPC_URL=""
STAKE_AMOUNT="1000000000000000000000000"
#REGISTRY_CONTRACT_ADDRESS="0x07E17e17E17e17E17e17E17E17E17e17e17E17e1"
