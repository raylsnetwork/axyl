+
+// BENCH OUTAGE HOOK (throwaway, never in a PR). With RL_BENCH_OUTAGE_START_MS and
+// RL_BENCH_OUTAGE_MS set, every consensus header request attempt made in the window
+// [first request + START, + DURATION] fails. With RL_BENCH_OUTAGE_SILENT set, each failing attempt
+// first hangs for 10 s, the network's request timeout, like a peer that does not answer.
+static BENCH_FIRST_REQUEST: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+
+async fn bench_outage() -> bool {
+    let env = |k: &str| std::env::var(k).ok().and_then(|v| v.parse::<u64>().ok());
+    let (Some(start), Some(dur)) = (env("RL_BENCH_OUTAGE_START_MS"), env("RL_BENCH_OUTAGE_MS"))
+    else {
+        return false;
+    };
+    let first = *BENCH_FIRST_REQUEST.get_or_init(std::time::Instant::now);
+    let at = first.elapsed().as_millis() as u64;
+    if at < start || at >= start + dur {
+        return false;
+    }
+    let silent = std::env::var_os("RL_BENCH_OUTAGE_SILENT").is_some();
+    tracing::warn!(target: "state-sync", at_ms = at, silent, "BENCH OUTAGE: failing a consensus header request");
+    if silent {
+        tokio::time::sleep(std::time::Duration::from_secs(10)).await;
+    }
+    true
+}
